
import React, { useEffect, useRef, useState } from "react";
import {
  Scissors, Sliders, Volume2, Mic, Type, Music,
  Play, Pause, Sparkles, Sticker, Square, CheckCircle2
} from "lucide-react";

type Props = {
  videoSrc?: string;
  onApply?: (settings: {
    startTime: number;
    endTime: number;
    filter: string;
    filterIntensity: number;
    videoVolume: number;
    musicVolume: number;
    musicSrc: string;
    voiceoverSrc: string;
    overlayText: string;
    textPosition: string;
    textOpacity: number;
    sticker: string;
  }) => void;
};

export default function AdvancedVideoStudioEditor({
  videoSrc,
  onApply
}: Props) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const musicRef = useRef<HTMLAudioElement>(null);
  const recorderRef = useRef<MediaRecorder | null>(null);
  const chunksRef = useRef<Blob[]>([]);
  const voiceUrlRef = useRef<string | null>(null);

  const [tab, setTab] = useState("trim");
  const [duration, setDuration] = useState(10);
  const [start, setStart] = useState(0);
  const [end, setEnd] = useState(10);
  const [playing, setPlaying] = useState(false);

  const [filter, setFilter] = useState("vivid");
  const [intensity, setIntensity] = useState(80);

  const [videoVolume, setVideoVolume] = useState(100);
  const [musicVolume, setMusicVolume] = useState(40);
  const [musicSrc, setMusicSrc] = useState("");
  const [voiceUrl, setVoiceUrl] = useState("");
  const [recording, setRecording] = useState(false);

  const [overlayText, setOverlayText] = useState("@nexora");
  const [position, setPosition] = useState("bottom-right");
  const [opacity, setOpacity] = useState(90);
  const [sticker, setSticker] = useState("");

  const filters: Record<string, string> = {
    original: "none",
    vivid: `saturate(${1 + intensity / 100 * 0.8}) contrast(${1 + intensity / 100 * 0.3})`,
    cinema: `contrast(${1 + intensity / 100 * 0.4}) sepia(${intensity / 100 * 0.35})`,
    mono: `grayscale(${intensity / 100}) contrast(${1 + intensity / 100 * 0.2})`,
    soft: `brightness(${1 + intensity / 100 * 0.15}) contrast(${1 - intensity / 100 * 0.15}) blur(${intensity / 100 * 0.5}px)`
  };

  useEffect(() => {
    if (videoRef.current) videoRef.current.volume = videoVolume / 100;
  }, [videoVolume]);

  useEffect(() => {
    if (musicRef.current) musicRef.current.volume = musicVolume / 100;
  }, [musicVolume]);

  useEffect(() => {
    return () => {
      if (voiceUrlRef.current) URL.revokeObjectURL(voiceUrlRef.current);
      if (musicSrc) URL.revokeObjectURL(musicSrc);
    };
  }, [musicSrc]);

  function loadMetadata() {
    const video = videoRef.current;
    if (!video || !Number.isFinite(video.duration)) return;
    setDuration(video.duration);
    setStart(0);
    setEnd(video.duration);
  }

  function updatePlayback() {
    const video = videoRef.current;
    if (!video) return;

    if (video.currentTime >= end) {
      video.pause();
      video.currentTime = start;
      musicRef.current?.pause();
      setPlaying(false);
    }
  }

  async function togglePlayback() {
    const video = videoRef.current;
    if (!video) return;

    if (video.paused) {
      if (video.currentTime < start || video.currentTime >= end) {
        video.currentTime = start;
      }
      await video.play();
      if (musicRef.current) {
        musicRef.current.currentTime = Math.max(0, video.currentTime - start);
        musicRef.current.play().catch(() => {});
      }
      setPlaying(true);
    } else {
      video.pause();
      musicRef.current?.pause();
      setPlaying(false);
    }
  }

  async function chooseMusic(file?: File) {
    if (!file) return;
    if (musicSrc) URL.revokeObjectURL(musicSrc);
    setMusicSrc(URL.createObjectURL(file));
  }

  async function startVoiceRecording() {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const recorder = new MediaRecorder(stream);
      chunksRef.current = [];

      recorder.ondataavailable = event => {
        if (event.data.size) chunksRef.current.push(event.data);
      };

      recorder.onstop = () => {
        const blob = new Blob(chunksRef.current, {
          type: recorder.mimeType || "audio/webm"
        });
        const url = URL.createObjectURL(blob);
        if (voiceUrlRef.current) URL.revokeObjectURL(voiceUrlRef.current);
        voiceUrlRef.current = url;
        setVoiceUrl(url);
        stream.getTracks().forEach(track => track.stop());
      };

      recorderRef.current = recorder;
      recorder.start();
      setRecording(true);
    } catch {
      alert("Microphone access was denied or is unavailable.");
    }
  }

  function stopVoiceRecording() {
    if (recorderRef.current?.state === "recording") {
      recorderRef.current.stop();
    }
    setRecording(false);
  }

  function applyEdits() {
    onApply?.({
      startTime: start,
      endTime: end,
      filter,
      filterIntensity: intensity,
      videoVolume,
      musicVolume,
      musicSrc,
      voiceoverSrc: voiceUrl,
      overlayText,
      textPosition: position,
      textOpacity: opacity,
      sticker
    });
  }

  const tabClass = (name: string) =>
    `rounded-xl px-2 py-3 text-xs font-semibold ${
      tab === name ? "bg-indigo-600 text-white" : "text-slate-400"
    }`;

  return (
    <div className="mx-auto w-full max-w-2xl rounded-3xl border border-slate-800 bg-slate-950 p-4 text-white shadow-2xl">

      {/* Video preview */}
      <div className="relative mb-4 aspect-video overflow-hidden rounded-2xl bg-black">
        {videoSrc ? (
          <video
            ref={videoRef}
            src={videoSrc}
            onLoadedMetadata={loadMetadata}
            onTimeUpdate={updatePlayback}
            onPlay={() => setPlaying(true)}
            onPause={() => setPlaying(false)}
            playsInline
            className="h-full w-full object-contain"
            style={{ filter: filters[filter] }}
          />
        ) : (
          <div className="flex h-full items-center justify-center text-center text-sm text-slate-500">
            <div>
              <Sparkles className="mx-auto mb-2" />
              Upload a video to start editing
            </div>
          </div>
        )}

        {overlayText && (
          <div
            className={`pointer-events-none absolute p-3 ${
              position === "top-left" ? "left-2 top-2" :
              position === "top-right" ? "right-2 top-2" :
              position === "bottom-left" ? "bottom-2 left-2" :
              "bottom-2 right-2"
            }`}
            style={{ opacity: opacity / 100 }}
          >
            <span className="rounded-lg border border-white/20 bg-black/60 px-3 py-1 text-xs font-bold">
              {overlayText}
            </span>
          </div>
        )}

        {sticker && (
          <div className="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-5xl">
            {sticker}
          </div>
        )}

        {videoSrc && (
          <button
            onClick={togglePlayback}
            className="absolute bottom-3 left-3 rounded-full bg-indigo-600 p-3"
            aria-label={playing ? "Pause video" : "Play video"}
          >
            {playing ? <Pause size={20} /> : <Play size={20} />}
          </button>
        )}
      </div>

      {/* Editor tabs */}
      <div className="mb-4 grid grid-cols-4 gap-1 rounded-2xl border border-slate-800 bg-slate-900 p-1">
        <button className={tabClass("trim")} onClick={() => setTab("trim")}><Scissors size={16} className="mx-auto mb-1" />Trim</button>
        <button className={tabClass("filters")} onClick={() => setTab("filters")}><Sliders size={16} className="mx-auto mb-1" />Filters</button>
        <button className={tabClass("audio")} onClick={() => setTab("audio")}><Volume2 size={16} className="mx-auto mb-1" />Audio</button>
        <button className={tabClass("overlay")} onClick={() => setTab("overlay")}><Type size={16} className="mx-auto mb-1" />Overlay</button>
      </div>

      {/* Trim */}
      {tab === "trim" && (
        <section className="space-y-4 rounded-2xl bg-slate-900 p-4">
          <div className="flex justify-between text-xs text-slate-300">
            <span>Trim selection</span>
            <span>{start.toFixed(1)}s – {end.toFixed(1)}s</span>
          </div>
          <label className="block text-xs text-slate-400">
            Start: {start.toFixed(1)}s
            <input
              type="range" min="0" max={Math.max(0, end - 0.5)}
              step="0.1" value={start}
              onChange={e => {
                const value = Number(e.target.value);
                setStart(value);
                if (videoRef.current) videoRef.current.currentTime = value;
              }}
              className="mt-2 w-full accent-indigo-500"
            />
          </label>
          <label className="block text-xs text-slate-400">
            End: {end.toFixed(1)}s
            <input
              type="range" min={Math.min(duration, start + 0.5)}
              max={duration} step="0.1" value={end}
              onChange={e => setEnd(Number(e.target.value))}
              className="mt-2 w-full accent-indigo-500"
            />
          </label>
          <p className="text-xs text-slate-500">Selected length: {(end - start).toFixed(1)} seconds</p>
        </section>
      )}

      {/* Filters */}
      {tab === "filters" && (
        <section className="space-y-4 rounded-2xl bg-slate-900 p-4">
          <p className="text-xs font-semibold">Choose a visual style</p>
          <div className="grid grid-cols-5 gap-1">
            {["original", "vivid", "cinema", "mono", "soft"].map(item => (
              <button
                key={item}
                onClick={() => setFilter(item)}
                className={`rounded-lg border px-1 py-2 text-xs capitalize ${
                  filter === item ? "border-indigo-500 bg-indigo-600" : "border-slate-700 bg-slate-950"
                }`}
              >
                {item}
              </button>
            ))}
          </div>
          <label className="block text-xs text-slate-400">
            Filter strength: {intensity}%
            <input
              type="range" min="0" max="100" value={intensity}
              onChange={e => setIntensity(Number(e.target.value))}
              className="mt-2 w-full accent-indigo-500"
            />
          </label>
        </section>
      )}

      {/* Audio */}
      {tab === "audio" && (
        <section className="space-y-4 rounded-2xl bg-slate-900 p-4">
          <label className="block text-xs text-slate-300">
            <Volume2 className="mr-2 inline" size={15} />
            Original video audio: {videoVolume}%
            <input
              type="range" min="0" max="100" value={videoVolume}
              onChange={e => setVideoVolume(Number(e.target.value))}
              className="mt-2 w-full accent-indigo-500"
            />
          </label>
          <label className="block text-xs text-slate-300">
            <Music className="mr-2 inline" size={15} />
            Background music: {musicVolume}%
            <input
              type="range" min="0" max="100" value={musicVolume}
              onChange={e => setMusicVolume(Number(e.target.value))}
              className="mt-2 w-full accent-indigo-500"
            />
          </label>
          <label className="block cursor-pointer rounded-xl border border-slate-700 bg-slate-950 p-3 text-center text-xs">
            Choose background music
            <input
              type="file" accept="audio/*" className="hidden"
              onChange={e => chooseMusic(e.target.files?.[0])}
            />
          </label>
          {musicSrc && <audio ref={musicRef} src={musicSrc} loop />}
          <div className="flex items-center justify-between border-t border-slate-800 pt-3">
            <span className="text-xs"><Mic className="mr-2 inline" size={15} />Voiceover recording</span>
            <button
              onClick={recording ? stopVoiceRecording : startVoiceRecording}
              className={`rounded-xl px-4 py-2 text-xs font-bold ${
                recording ? "bg-red-600" : "bg-indigo-600"
              }`}
            >
              {recording ? <><Square size={12} className="mr-1 inline" />Stop</> : "Start recording"}
            </button>
          </div>
          {voiceUrl && <audio controls src={voiceUrl} className="w-full" />}
        </section>
      )}

      {/* Text and stickers */}
      {tab === "overlay" && (
        <section className="space-y-4 rounded-2xl bg-slate-900 p-4">
          <label className="block text-xs text-slate-300">
            Text or creator watermark
            <input
              value={overlayText}
              onChange={e => setOverlayText(e.target.value)}
              placeholder="@yourusername"
              className="mt-2 w-full rounded-xl border border-slate-700 bg-slate-950 p-3 text-sm"
            />
          </label>
          <label className="block text-xs text-slate-300">
            Text position
            <select
              value={position}
              onChange={e => setPosition(e.target.value)}
              className="mt-2 w-full rounded-xl border border-slate-700 bg-slate-950 p-3"
            >
              <option value="top-left">Top left</option>
              <option value="top-right">Top right</option>
              <option value="bottom-left">Bottom left</option>
              <option value="bottom-right">Bottom right</option>
            </select>
          </label>
          <label className="block text-xs text-slate-300">
            Text opacity: {opacity}%
            <input
              type="range" min="20" max="100" value={opacity}
              onChange={e => setOpacity(Number(e.target.value))}
              className="mt-2 w-full accent-indigo-500"
            />
          </label>
          <div>
            <p className="mb-2 text-xs text-slate-300"><Sticker className="mr-2 inline" size={15} />Choose a sticker</p>
            <div className="flex flex-wrap gap-2">
              {["🔥", "❤️", "😂", "⭐", "🚀", "👏", "💯", "✨"].map(item => (
                <button
                  key={item}
                  onClick={() => setSticker(sticker === item ? "" : item)}
                  className={`rounded-lg p-2 text-2xl ${sticker === item ? "bg-indigo-600" : "bg-slate-950"}`}
                >
                  {item}
                </button>
              ))}
            </div>
          </div>
        </section>
      )}

      <button
        onClick={applyEdits}
        className="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 py-3 text-sm font-bold hover:bg-indigo-500"
      >
        <CheckCircle2 size={17} /> Apply editing settings
      </button>
    </div>
  );
}
